  --glass-border: rgba(255,255,255,0.15);
  --cyan: #00F3FF;
  --magenta: #FF00E5;
  --gold: #FFD700;
  --emerald: #00FF9D;
  --text: #F5F2ED;
  --muted: #8A94A6;
  --error: #FF4444;
}
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family:'Inter',sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height:1.6;
  overflow-x:hidden;
  min-height:100vh;
}
.bg-effects {
  position:fixed; inset:0; z-index:-1;
  background: radial-gradient(circle at 20% 30%, rgba(0,243,255,0.1) 0%, transparent 50%),
              radial-gradient(circle at 80% 70%, rgba(255,0,229,0.1) 0%, transparent 50%);
  filter:blur(60px);
}
.container { max-width:1000px; margin:0 auto; padding:30px 20px; }
header { text-align:center; margin-bottom:40px; }
h1 {
  font-family:'Orbitron',sans-serif;
  font-size:clamp(1.5rem,4vw,2.5rem);
  background:linear-gradient(90deg,var(--cyan),var(--magenta),var(--gold));
  -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  margin-bottom:15px;
}
.progress-wrap {
  height:8px; background:rgba(255,255,255,0.1); border-radius:10px; overflow:hidden; margin:20px 0;
}
.progress-fill {
  height:100%; width:0%; background:linear-gradient(90deg,var(--cyan),var(--emerald));
  transition:width 0.5s ease;
}
.section {
  background:var(--glass); backdrop-filter:blur(16px);
  border:1px solid var(--glass-border); border-radius:20px;
  padding:30px; margin-bottom:30px; position:relative; overflow:hidden;
  opacity:0.6; pointer-events:none; filter:grayscale(0.5);
  transition:all 0.4s ease;
}
.section.active { opacity:1; pointer-events:all; filter:none; border-color:var(--cyan); box-shadow:0 0 30px rgba(0,243,255,0.2); }
.section-title {
  font-family:'Orbitron',sans-serif;
  font-size:1.3rem; color:var(--gold); margin-bottom:10px;
  display:flex; align-items:center; gap:10px;
}
.section-desc { color:var(--muted); margin-bottom:25px; font-size:0.9rem; }
.exercise-item {
  background:rgba(0,0,0,0.3); border-radius:12px;
  padding:20px; margin-bottom:20px; border-left:4px solid var(--cyan);
}
.exercise-label { font-weight:600; margin-bottom:12px; display:block; }
.exercise-input {
  width:100%; padding:12px; background:rgba(255,255,255,0.05);
  border:1px solid var(--glass-border); border-radius:8px; color:var(--text);
  font-size:1rem; margin-bottom:12px;
}
.exercise-input:focus { outline:none; border-color:var(--cyan); }
.btn {
  padding:10px 20px; border:none; border-radius:10px; font-weight:600; cursor:pointer;
  transition:0.3s; font-size:0.95rem; margin:5px;
}
.btn-verify { background:var(--glass); border:1px solid var(--glass-border); color:var(--text); }
.btn-verify:hover { background:rgba(255,255,255,0.1); }
.btn-next {
  background:var(--emerald); color:#000; padding:15px 30px;
  font-size:1rem; margin-top:20px;
}
.btn-next:hover { transform:translateY(-2px); box-shadow:0 5px 20px rgba(0,255,157,0.4); }
.btn-sports {
  background:linear-gradient(135deg,var(--orange,#F27D26),var(--green,#00FF00)); 
  color:#000; padding:15px 30px; font-size:1rem; margin-top:20px;
}
.btn-sports:hover { transform:translateY(-2px); box-shadow:0 5px 20px rgba(0,255,157,0.4); }
.feedback {
  margin-top:10px; padding:10px; border-radius:8px; font-size:0.9rem; display:none;
  border-left:4px solid;
}
.feedback.success { background:rgba(0,255,157,0.1); border-left-color:var(--emerald); color:var(--emerald); }
.feedback.error { background:rgba(255,68,68,0.1); border-left-color:var(--error); color:var(--error); }
