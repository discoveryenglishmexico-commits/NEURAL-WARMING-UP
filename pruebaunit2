  const val = normalizeText(document.getElementById('ex1a').value);
  const correct = normalizeText("Is this the classroom's globe?");
  const fb = document.getElementById('fb1a');
  const ans = document.getElementById('ans1a');
  
  if(val === correct) {
    fb.className = 'feedback success';
    fb.textContent = '✅ Correcto';
    fb.style.display = 'block';
    ans.style.display = 'none';
    speak('Very Nice!');
    completedCount++; updateProgress();
  } else {
    fb.className = 'feedback error';
    fb.textContent = '❌ Incorrecto';
    fb.style.display = 'block';
    ans.style.display = 'block';
    speak('Sorry, try again');
  }
}

