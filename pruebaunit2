<script>
// AUDIO FEEDBACK con Web Speech API
const synth = window.speechSynthesis;
function speak(text) {
  if(synth.speaking) synth.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US'; u.rate = 1.1; u.pitch = 1;
  synth.speak(u);
}

let completedCount = 0;
const totalEx = 22; // Total de ejercicios (sin deportes)

function updateProgress() {
  document.getElementById('progressBar').style.width = `${(completedCount / totalEx) * 100}%`;
}

function normalizeText(text) {
  if (!text) return "";
  return text.toLowerCase().replace(/[?!.,']/g, "").replace(/\s+/g, " ").trim();
}

function scrollToSec(num) {
  document.getElementById(`sec${num-1}`).classList.remove('active');
  document.getElementById(`sec${num}`).classList.add('active');
  document.getElementById(`sec${num}`).scrollIntoView({behavior:'smooth'});
  speak('Next section unlocked');
}

